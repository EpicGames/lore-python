        return self.cdata

    def clone(self) -> {{ class_name }}:
        return {{ class_name }}(
        {% for field in struct_fields %}
            {% set field_type = field.0 %}
            {% set field_name = field.1 %}
            {% if field_type in ["lore_hash_t", "lore_context_t", "lore_partition_t", "lore_branch_id_t", "lore_repository_id_t", "lore_instance_id_t"] %}
                {{ field_name }} = self.{{ field_name }}.data,
            {% elif field_type in from_ffi_struct_types %}
                {{ field_name }} = self.{{ field_name }}.clone(),
            {% elif field_type in blit_types %}
                {{ field_name }} = {{ pascal_case(field_type.removesuffix("_t")) }}.to_native(self.cdata.{{ field_name }}),
            {% else %}
                {{ field_name }} = self.{{ field_name }},
            {% endif %}
        {% endfor %}
        )

    {% endif %}
{% endfor %}
